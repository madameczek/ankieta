{
  "ConnectionStrings": {
    "Polls": "from-secrets"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Graylog": {
    "Address": "",
    "Port": 12201,
    "AppName": "Polls-API",
    "MinimumLevel": "Information"
  },
  "Session": {
    "SecureCookie": true
  },
  "RateLimiting": {
    "Global": { "PermitLimit": 300, "WindowSeconds": 60 },
    "Create": { "PermitLimit": 10, "WindowSeconds": 60 },
    "ClientIpHeader": ""
  },
  "Thresholds": {
    "Users": { "Warning": 2000, "Lockout": 3000 },
    "Polls": { "Warning": 3000, "Lockout": 5000 }
  },
  "EmailApi": {
    "Url": "from-secrets",
    "ApiKey": "from-secrets",
    "From": "from-secrets",
    "To": "from-secrets",
    "SubjectTag": "",
    "Signature": "Polls",
    "TimeoutSeconds": 10
  },
  "AllowedHosts": "*"
}
