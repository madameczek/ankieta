{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Graylog": {
    "Address": "",
    "Port": 12201,
    "AppName": "Polls-API",
    "MinimumLevel": "Information"
  },
  "Session": {
    "SecureCookie": true
  },
  "RateLimiting": {
    "Global": { "PermitLimit": 300, "WindowSeconds": 60 },
    "Create": { "PermitLimit": 10, "WindowSeconds": 60 },
    "ClientIpHeader": ""
  },
  "Thresholds": {
    "AdminEmail": "",
    "Users": { "Warning": 2000, "Lockout": 3000 },
    "Polls": { "Warning": 3000, "Lockout": 5000 }
  },
  "AllowedHosts": "*"
}
