# E2E smoke test (C2): copy to .env (never committed) and fill in. KEY=VALUE, no quotes.
# Use a database of its own – never the app database.

# SQL Server host (and port) and the test database name; the database must already exist
E2E_SQL_SERVER=<host>,1433
E2E_SQL_DATABASE=<test-database>

# DDL login: applies src/polls/db/migrations.sql (sqlcmd -I) and, if allowed below, resets the data
E2E_SQL_DDL_USER=<ddl-login>
E2E_SQL_DDL_PASSWORD=<ddl-password>

# DML login: used by the API during the test (ConnectionStrings__Polls); may be the same login as above
E2E_SQL_DML_USER=<dml-login>
E2E_SQL_DML_PASSWORD=<dml-password>

# true: delete all rows before each run (the database name must contain "e2e" or "test"); false: keep data, the test uses unique names
E2E_RESET_DB=true

# Local ports for the API and the Angular dev server started by the test (change if taken)
E2E_API_PORT=5180
E2E_WEB_PORT=4300
